FROM node:24-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    chromium ca-certificates fonts-liberation fonts-noto-color-emoji tini \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force
COPY server ./server
COPY shared ./shared
COPY api ./api
COPY scripts/reconstruction-worker.mjs scripts/worker-server.mjs scripts/check-worker.mjs ./scripts/
RUN mkdir -p /data/jobs && chown -R node:node /data
ENV NODE_ENV=production \
    PORT=3101 \
    FUSION_JOB_DIR=/data/jobs \
    FUSION_BROWSER_PROVIDER=local \
    FUSION_CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium \
    FUSION_CHROMIUM_SANDBOX=true \
    FUSION_WORKER_CONCURRENCY=1
USER node
EXPOSE 3101
HEALTHCHECK --interval=30s --timeout=5s --start-period=90s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+process.env.PORT+'/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["node", "scripts/worker-server.mjs"]
