# Vercel gateway and worker: use the SAME private Blob store and worker secret.
BLOB_READ_WRITE_TOKEN=
FUSION_WORKER_SECRET=

# Gateway only. Omit this to retain the existing local detached-worker mode.
# HTTPS is mandatory except for localhost development.
FUSION_WORKER_URL=

# Free live testing: gateway=worker; Mac worker=local (no Blob reads/writes).
# Omit for the existing shared-Blob deployment.
FUSION_STORAGE_BACKEND=

# Worker only: keep all model credentials server-side.
FUSION_AI_PROVIDER=nvidia
FUSION_MODEL=moonshotai/kimi-k3
FUSION_MODEL_VISION=true
FUSION_ALLOW_PAID_MODELS=false
NVIDIA_API_KEY=
FUSION_BROWSER_PROVIDER=local
FUSION_WORKER_CONCURRENCY=1
FUSION_WORKER_MAX_PENDING=20
FUSION_DAILY_LIMIT=40
# Set to /data/jobs for Docker, or another persistent volume on your host.
FUSION_JOB_DIR=.fusion-jobs
# Dockerfile supplies /usr/bin/chromium; omit on macOS to use installed Chrome.
FUSION_CHROMIUM_EXECUTABLE_PATH=
FUSION_CHROMIUM_SANDBOX=true
PORT=3101
